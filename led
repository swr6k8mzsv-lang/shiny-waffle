def get_conn():
    return sqlite3.connect(DB_PATH, check_same_thread=False)


def init_db():
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS leads (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            place_id TEXT UNIQUE,
            business_name TEXT,
            segment TEXT,
            city TEXT,
            address TEXT,
            phone TEXT,
            website TEXT,
            google_maps_url TEXT,
            rating REAL,
            user_ratings_total INTEGER,
            status TEXT DEFAULT 'New',
            priority TEXT DEFAULT 'Warm',
            contact_name TEXT,
            contact_title TEXT,
            contact_email TEXT,
            notes TEXT,
            last_contacted TEXT,
            follow_up_date TEXT,
            created_at TEXT,
            updated_at TEXT
        )
        """
    )
    conn.commit()
    conn.close()


def infer_segment(search_term: str, business_name: str = "") -> str:
    combined = f"{search_term} {business_name}".lower()
    for key, segment in SEGMENT_MAPPING.items():
        if key.lower() in combined:
            return segment
    return "General Venue / Business"


def google_places_text_search(query: str) -> List[Dict]:
    """Search Google Places Text Search API."""
    if not GOOGLE_MAPS_API_KEY:
        st.error("Missing GOOGLE_MAPS_API_KEY in .env file.")
        return []

    endpoint = "https://maps.googleapis.com/maps/api/place/textsearch/json"
    params = {
        "query": query,
        "key": GOOGLE_MAPS_API_KEY,
    }

    all_results = []
    next_page_token = None

    for page in range(3):
        if next_page_token:
            # Google requires a short delay before next_page_token becomes valid.
            time.sleep(2)
            params = {
                "pagetoken": next_page_token,
                "key": GOOGLE_MAPS_API_KEY,
            }

        resp = requests.get(endpoint, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()

        status = data.get("status")
        if status not in ["OK", "ZERO_RESULTS"]:
            st.warning(f"Google Places returned status: {status} - {data.get('error_message', '')}")
            break

        results = data.get("results", [])
        all_results.extend(results)
        next_page_token = data.get("next_page_token")

        if not next_page_token:
            break

    return all_results


def google_place_details(place_id: str) -> Dict:
    """Fetch phone, website, address, and Maps URL."""
    if not GOOGLE_MAPS_API_KEY:
        return {}

    endpoint = "https://maps.googleapis.com/maps/api/place/details/json"
    fields = ",".join([
        "place_id",
        "name",
        "formatted_address",
        "formatted_phone_number",
        "website",
        "url",
        "rating",
        "user_ratings_total",
    ])
    params = {
        "place_id": place_id,
        "fields": fields,
        "key": GOOGLE_MAPS_API_KEY,
    }
    resp = requests.get(endpoint, params=params, timeout=20)
    resp.raise_for_status()
    data = resp.json()
    return data.get("result", {})


def upsert_lead(lead: Dict):
    conn = get_conn()
    cur = conn.cursor()
    now = datetime.utcnow().isoformat()

    cur.execute(
        """
        INSERT INTO leads (
            place_id, business_name, segment, city, address, phone, website,
            google_maps_url, rating, user_ratings_total, status, priority,
            created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(place_id) DO UPDATE SET
            business_name=excluded.business_name,
            segment=excluded.segment,
            city=excluded.city,
            address=excluded.address,
            phone=excluded.phone,
            website=excluded.website,
            google_maps_url=excluded.google_maps_url,
            rating=excluded.rating,
            user_ratings_total=excluded.user_ratings_total,
            updated_at=excluded.updated_at
        """,
        (
            lead.get("place_id"),
            lead.get("business_name"),
            lead.get("segment"),
            lead.get("city"),
            lead.get("address"),
            lead.get("phone"),
            lead.get("website"),
            lead.get("google_maps_url"),
            lead.get("rating"),
            lead.get("user_ratings_total"),
            lead.get("status", "New"),
            lead.get("priority", "Warm"),
            now,
            now,
        ),
    )
    conn.commit()
    conn.close()


def fetch_leads(where_clause: str = "", params: tuple = ()) -> pd.DataFrame:
    conn = get_conn()
    query = "SELECT * FROM leads"
    if where_clause:
        query += f" WHERE {where_clause}"
    query += " ORDER BY updated_at DESC"
    df = pd.read_sql_query(query, conn, params=params)
    conn.close()
    return df


def update_lead_field(lead_id: int, updates: Dict):
    if not updates:
        return
    conn = get_conn()
    cur = conn.cursor()
    updates["updated_at"] = datetime.utcnow().isoformat()
    set_clause = ", ".join([f"{k} = ?" for k in updates.keys()])
    values = list(updates.values()) + [lead_id]
    cur.execute(f"UPDATE leads SET {set_clause} WHERE id = ?", values)
    conn.commit()
    conn.close()


