def mailto_link(email: str, subject: str, body: str) -> str:
    return "mailto:" + urllib.parse.quote(email) + "?subject=" + urllib.parse.quote(subject) + "&body=" + urllib.parse.quote(body)


def click_to_call_link(phone: str) -> str:
    cleaned = "".join(ch for ch in phone if ch.isdigit() or ch == "+")
    return f"tel:{cleaned}"


def send_email(recipient_email: str, subject: str, body: str) -> tuple[bool, str]:
    """Send email via SMTP. Returns (success: bool, message: str)."""
    if not SMTP_PASSWORD or not SALES_EMAIL:
        return False, "SMTP_PASSWORD or SALES_EMAIL not configured in .env file."

    try:
        msg = MIMEMultipart()
        msg["From"] = SALES_EMAIL
        msg["To"] = recipient_email
        msg["Subject"] = subject
        msg.attach(MIMEText(body, "plain"))

        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
            server.starttls()
            server.login(SALES_EMAIL, SMTP_PASSWORD)
            server.send_message(msg)
        return True, f"Email sent successfully to {recipient_email}."
    except Exception as e:
        return False, f"Failed to send email: {str(e)}"


def prospect_search_ui():
    st.subheader("1. Generate New Leads")

    col1, col2 = st.columns(2)
    with col1:
        selected_cities = st.multiselect("Target cities", TARGET_CITIES, default=["Houston, TX", "Austin, TX", "San Antonio, TX", "Oklahoma City, OK", "Tulsa, OK"])
    with col2:
        selected_terms = st.multiselect("Search categories", DEFAULT_SEARCH_TERMS, default=["sports bar with patio", "live music venue", "outdoor event venue", "AV rental company"])

    custom_terms = st.text_area(
        "Optional custom search terms, one per line",
        placeholder="Example:\nWorld Cup watch party venue\nlarge patio bar\noutdoor concert venue",
    )

    if custom_terms.strip():
        selected_terms += [t.strip() for t in custom_terms.splitlines() if t.strip()]

    max_details = st.slider("Max detailed leads to import per search batch", 10, 300, 60)

    if st.button("Search & Import Leads", type="primary"):
        if not selected_cities or not selected_terms:
            st.warning("Select at least one city and one search category.")
            return

        imported = 0
        seen_place_ids = set()
        progress = st.progress(0)
        total_queries = len(selected_cities) * len(selected_terms)
        query_count = 0

        with st.status("Searching Google Places and importing leads...", expanded=True) as status:
            for city in selected_cities:
                for term in selected_terms:
                    query_count += 1
                    progress.progress(query_count / total_queries)
                    search_query = f"{term} in {city}"
                    st.write(f"Searching: {search_query}")

                    try:
                        results = google_places_text_search(search_query)
                    except Exception as e:
                        st.error(f"Search failed for {search_query}: {e}")
                        continue

                    for result in results:
                        if imported >= max_details:
                            break

                        place_id = result.get("place_id")
                        if not place_id or place_id in seen_place_ids:
                            continue
                        seen_place_ids.add(place_id)

                        try:
                            details = google_place_details(place_id)
                        except Exception as e:
                            st.warning(f"Could not fetch details for {result.get('name')}: {e}")
                            details = result

                        business_name = details.get("name") or result.get("name")
                        segment = infer_segment(term, business_name)

                        lead = {
                            "place_id": place_id,
                            "business_name": business_name,
                            "segment": segment,
                            "city": city,
                            "address": details.get("formatted_address") or result.get("formatted_address"),
                            "phone": details.get("formatted_phone_number"),
                            "website": details.get("website"),
                            "google_maps_url": details.get("url"),
                            "rating": details.get("rating") or result.get("rating"),
                            "user_ratings_total": details.get("user_ratings_total") or result.get("user_ratings_total"),
                            "status": "New",
                            "priority": "Warm",
                        }
                        upsert_lead(lead)
                        imported += 1

                    if imported >= max_details:
                        break
                if imported >= max_details:
                    break

            status.update(label=f"Imported/updated {imported} leads.", state="complete")


def dashboard_ui():
    st.subheader("2. Live Sales Dashboard")
    df = fetch_leads()

    if df.empty:
        st.info("No leads yet. Use the lead generator first.")
        return

    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Total Leads", len(df))
    col2.metric("Hot Leads", int((df["priority"] == "Hot").sum()))
    col3.metric("Interested", int((df["status"] == "Interested").sum()))
    col4.metric("Quoted", int((df["status"] == "Quoted").sum()))

    st.write("### Pipeline by Status")
    status_counts = df["status"].fillna("New").value_counts().reset_index()
    status_counts.columns = ["Status", "Count"]
    st.bar_chart(status_counts.set_index("Status"))

    st.write("### Leads by City")
    city_counts = df["city"].fillna("Unknown").value_counts().reset_index()
    city_counts.columns = ["City", "Count"]
    st.bar_chart(city_counts.set_index("City"))

    st.write("### CRM Table")
    filter_col1, filter_col2, filter_col3 = st.columns(3)
    with filter_col1:
        city_filter = st.multiselect("Filter by city", sorted(df["city"].dropna().unique().tolist()))
    with filter_col2:
        status_filter = st.multiselect("Filter by status", STATUS_OPTIONS)
    with filter_col3:
        priority_filter = st.multiselect("Filter by priority", PRIORITY_OPTIONS)

    filtered = df.copy()
    if city_filter:
        filtered = filtered[filtered["city"].isin(city_filter)]
    if status_filter:
        filtered = filtered[filtered["status"].isin(status_filter)]
    if priority_filter:
        filtered = filtered[filtered["priority"].isin(priority_filter)]

    st.dataframe(
        filtered[[
            "id",
            "business_name",
            "segment",
            "city",
            "phone",
            "website",
            "rating",
            "status",
            "priority",
            "follow_up_date",
            "notes",
        ]],
        use_container_width=True,
        hide_index=True,
    )

    csv = filtered.to_csv(index=False).encode("utf-8")
    st.download_button(
        "Export Filtered Leads to CSV",
        data=csv,
        file_name=f"led_wall_leads_{date.today().isoformat()}.csv",
        mime="text/csv",
    )


