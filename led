def manual_add_ui():
    st.subheader("5. Manually Add a Lead")
    with st.form("manual_add"):
        business_name = st.text_input("Business name")
        segment = st.selectbox("Segment", sorted(set(SEGMENT_MAPPING.values())) + ["General Venue / Business"])
        city = st.text_input("City", value="DFW, TX")
        address = st.text_input("Address")
        phone = st.text_input("Phone")
        website = st.text_input("Website")
        contact_name = st.text_input("Contact name")
        contact_title = st.text_input("Contact title")
        contact_email = st.text_input("Contact email")
        priority = st.selectbox("Priority", PRIORITY_OPTIONS, index=1)
        notes = st.text_area("Notes")
        submitted = st.form_submit_button("Add Lead", type="primary")

        if submitted:
            if not business_name:
                st.warning("Business name is required.")
                return
            manual_place_id = f"manual_{business_name}_{city}_{datetime.utcnow().timestamp()}"
            lead = {
                "place_id": manual_place_id,
                "business_name": business_name,
                "segment": segment,
                "city": city,
                "address": address,
                "phone": phone,
                "website": website,
                "google_maps_url": "",
                "rating": None,
                "user_ratings_total": None,
                "status": "New",
                "priority": priority,
            }
            upsert_lead(lead)
            df = fetch_leads("place_id = ?", (manual_place_id,))
            if not df.empty:
                update_lead_field(
                    int(df.iloc[0]["id"]),
                    {
                        "contact_name": contact_name,
                        "contact_title": contact_title,
                        "contact_email": contact_email,
                        "notes": notes,
                    },
                )
            st.success("Manual lead added.")
            time.sleep(0.5)
            st.rerun()


